{
  "name": "dsh-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "DSH-Desktop: Electron desktop shell that boots the dsh web host and renders the browser UI.",
  "type": "commonjs",
  "main": "dist/main.js",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run && node --test test/*.test.cjs",
    "test:watch": "vitest",
    "collect": "node scripts/collect-runtime.mjs",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && npm run collect && electron-builder --mac",
    "dist:win": "npm run build && npm run collect && electron-builder --win"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@types/node": "^22.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "com.justgenius.dshdesktop",
    "productName": "DSH-Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "build/icon-app.png",
      "build/icon-mac.png",
      "build/icon.png",
      "build/splash.html",
      "build/plugin-recovery.html"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*",
          "!**/*.exe",
          "!**/*.map",
          "!**/pnpm/dist/node_modules/@reflink/**"
        ]
      },
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "install-desktop-plugin.mjs"
        ]
      },
      {
        "from": "build/icon-mac.png",
        "to": "dock-icon.png"
      }
    ],
    "asar": true,
    "electronLanguages": [
      "en",
      "zh_CN"
    ],
    "icon": "build/icon-app.png",
    "mac": {
      "icon": "build/icon.icns",
      "extendInfo": {
        "NSUserNotificationAlertStyle": "alert",
        "LSUIElement": false
      },
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "identity": null
    },
    "win": {
      "icon": "build/icon.ico",
      "electronLanguages": [
        "en-US",
        "zh-CN"
      ],
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "buildVersion": "2026082618"
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017"
}
