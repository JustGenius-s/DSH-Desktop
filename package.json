{
  "name": "dsh-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "DSH-Desktop: Electron desktop shell that boots the dsh web host and renders the browser UI.",
  "type": "commonjs",
  "main": "dist/main.js",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "collect": "node scripts/collect-runtime.mjs",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && npm run collect && electron-builder --mac",
    "dist:win": "npm run build && npm run collect && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^6.0.3"
  },
  "build": {
    "appId": "com.justgenius.dshdesktop",
    "productName": "DSH-Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "build/icon-app.png",
      "build/icon.png",
      "build/splash.html"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      },
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "install-desktop-plugin.mjs"
        ]
      }
    ],
    "asar": true,
    "electronLanguages": [
      "en",
      "zh_CN"
    ],
    "icon": "build/icon-app.png",
    "mac": {
      "icon": "build/icon.icns",
      "extendInfo": {
        "NSUserNotificationAlertStyle": "alert"
      },
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017"
}
