{
  "name": "@deepseek-ai/dsh-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "DSH-Deck: Electron desktop shell that boots the dsh web host and renders the browser UI.",
  "type": "commonjs",
  "main": "dist/main.js",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "collect": "node scripts/collect-runtime.mjs",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && npm run collect && electron-builder --mac",
    "dist:win": "npm run build && npm run collect && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^6.0.3"
  },
  "build": {
    "appId": "com.dshdeck.desktop",
    "productName": "DSH-Deck",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "build/icon.png",
      "build/splash.html"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      }
    ],
    "asar": true,
    "icon": "build/icon.png",
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
